{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${mod_license}",
  "contact": {
    "email": "example@thisismyactual.email",
    "issues": "https://github.com/${github}/issues",
    "sources": "https://github.com/${github}"
  },
  "icon": "assets/minecraftxiv/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "wtf.kity.minecraftxiv.ClientInit"
    ],
    "server": [
      "wtf.kity.minecraftxiv.ServerInit"
    ],
    "modmenu": [
      "wtf.kity.minecraftxiv.config.Gui"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=${yacl_version}"
